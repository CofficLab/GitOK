    "Confirm Undo Commit?": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Confirm Undo Commit?" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "确认撤销提交？" } },
