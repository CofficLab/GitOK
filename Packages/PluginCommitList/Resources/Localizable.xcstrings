  "strings": {
    "Choose a project from the sidebar to see its commits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a project from the sidebar to see its commits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从侧边栏选择项目以查看其提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從側邊欄選擇專案以查看其提交。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
