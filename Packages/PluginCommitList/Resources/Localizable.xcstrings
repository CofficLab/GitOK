    "Revert commit \"%@\"? This creates a new commit.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Revert commit \"%@\"? This creates a new commit." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "要反转提交“%@”吗？这会创建一个新提交。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "要反轉提交「%@」嗎？這會建立一個新提交。" } },
        "zh-HK": { "stringUnit": { "state": "translated", "value": "要反轉提交「%@」嗎？這會建立一個新提交。" } },
