    "HEAD will move to this commit. Changes from subsequent commits will be preserved in the staging area.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "HEAD will move to this commit. Changes from subsequent commits will be preserved in the staging area." } },
