    "HEAD, the staging area, and tracked working files will be discarded back to this commit. This cannot be undone.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "HEAD, the staging area, and tracked working files will be discarded back to this commit. This cannot be undone." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "HEAD、暂存区和已跟踪工作区文件都会回退到此提交，且无法撤销。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "HEAD、暫存區和已追蹤工作區檔案都會回退到此提交，且無法撤銷。" } },
        "zh-HK": { "stringUnit": { "state": "translated", "value": "HEAD、暫存區和已追蹤工作區檔案都會回退到此提交，且無法撤銷。" } },
        "zh-TW": { "stringUnit": { "state": "translated", "value": "HEAD、暫存區和已追蹤工作區檔案都會回退到此提交，且無法撤銷。" } }
      }
    },
