    "After undoing, this commit's changes will remain in the working tree.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "After undoing, this commit's changes will remain in the working tree." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "撤销后，此提交的文件改动会保留在工作区。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "撤銷後，此提交的檔案變更會保留在工作區。" } },
        "zh-HK": { "stringUnit": { "state": "translated", "value": "撤銷後，此提交的檔案變更會保留在工作區。" } },
