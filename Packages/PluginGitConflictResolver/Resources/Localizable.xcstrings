    "Resolve all conflicts before continuing the merge.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Resolve all conflicts before continuing the merge." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请先解决所有冲突，再继续合并。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "請先解決所有衝突，再繼續合併。" } },
        "zh-HK": { "stringUnit": { "state": "translated", "value": "請先解決所有衝突，再繼續合併。" } },
        "zh-TW": { "stringUnit": { "state": "translated", "value": "請先解決所有衝突，再繼續合併。" } }
      }
    },
    "This discards the in-progress merge and restores the pre-merge state.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This discards the in-progress merge and restores the pre-merge state." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这会放弃正在进行的合并并恢复合并前状态。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "這會放棄正在進行的合併並恢復合併前狀態。" } },
        "zh-HK": { "stringUnit": { "state": "translated", "value": "這會放棄正在進行的合併並恢復合併前狀態。" } },
        "zh-TW": { "stringUnit": { "state": "translated", "value": "這會放棄正在進行的合併並恢復合併前狀態。" } }
      }
    },
    "This discards the in-progress cherry-pick and restores the pre-cherry-pick state.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This discards the in-progress cherry-pick and restores the pre-cherry-pick state." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这会放弃正在进行的 Cherry-pick 并恢复操作前状态。" } }
      }
    },
    "Resolve all conflicts before continuing the cherry-pick.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Resolve all conflicts before continuing the cherry-pick." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请先解决所有冲突，再继续 Cherry-pick。" } }
      }
    },
