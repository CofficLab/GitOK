    "The CA file is written to `http.sslCAInfo`. Disabling SSL verification is only suitable for temporary troubleshooting; enterprise networks should prioritize importing trusted CA certificates." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The CA file is written to `http.sslCAInfo`. Disabling SSL verification is only suitable for temporary troubleshooting; enterprise networks should prioritize importing trusted CA certificates."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CA 文件会写入 `http.sslCAInfo`。仅建议在临时排查问题时关闭 SSL 验证；企业网络应优先导入受信任的 CA 证书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CA 檔案會寫入 `http.sslCAInfo`。僅建議在臨時排除問題時關閉 SSL 驗證；企業網路應優先匯入受信任的 CA 憑證。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CA 檔案會寫入 `http.sslCAInfo`。僅建議在臨時排除問題時關閉 SSL 驗證；企業網路應優先匯入受信任的 CA 憑證。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CA 檔案會寫入 `http.sslCAInfo`。僅建議在臨時排除問題時關閉 SSL 驗證；企業網路應優先匯入受信任的 CA 憑證。"
          }
        }
      }
    },
    "Verifies the certificate of remote hosts over HTTPS" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies the certificate of remote hosts over HTTPS"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "验证通过 HTTPS 连接的远程主机证书"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驗證透過 HTTPS 連線的遠端主機憑證"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驗證透過 HTTPS 連線的遠端主機憑證"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驗證透過 HTTPS 連線的遠端主機憑證"
          }
        }
      }
    },
    "Writes to Git global config `http.proxy` and `https.proxy`. If the proxy requires authentication, use the format `http://user:password@host:port`." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes to Git global config `http.proxy` and `https.proxy`. If the proxy requires authentication, use the format `http://user:password@host:port`."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写入 Git 全局配置 `http.proxy` 和 `https.proxy`。如果代理需要认证，请使用 `http://user:password@host:port` 格式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫入 Git 全域設定 `http.proxy` 和 `https.proxy`。如果代理需要驗證，請使用 `http://user:password@host:port` 格式。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫入 Git 全域設定 `http.proxy` 和 `https.proxy`。如果代理需要驗證，請使用 `http://user:password@host:port` 格式。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫入 Git 全域設定 `http.proxy` 和 `https.proxy`。如果代理需要驗證，請使用 `http://user:password@host:port` 格式。"
          }
        }
      }
    }
  },
  "version" : "1.0"
