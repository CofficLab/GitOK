  "strings": {
    "Any view asks for a diff between two refs or files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any view asks for a diff between two refs or files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何视图都可在两个引用或文件间请求差异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何視圖都可在兩個引用或文件間請求差異。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "任何視圖都可在兩個引用或文件間請求差異。"
