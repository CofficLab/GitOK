        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitOK 把每個操作翻譯為精確的 git 呼叫。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "GitOK 把每個操作翻譯為精確的 git 呼叫。"
