  "strings": {
    "This directory is not a Git repository: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This directory is not a Git repository: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该目录不是 Git 仓库：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該目錄不是 Git 儲存庫：%@"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "該目錄不是 Git 儲存庫：%@"
