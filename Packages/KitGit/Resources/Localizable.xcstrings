    "The working tree must be clean before undoing a commit.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The working tree must be clean before undoing a commit." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "撤销提交前工作区必须干净。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "撤銷提交前工作區必須乾淨。" } },
