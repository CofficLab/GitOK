    "Git command not found. Please make sure git is installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Git command not found. Please make sure git is installed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 git 命令，请确认系统已安装 git"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 git 指令，請確認系統已安裝 git"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 git 指令，請確認系統已安裝 git"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 git 指令，請確認系統已安裝 git"
          }
        }
      }
    },
