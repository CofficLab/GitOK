    "The working tree must be clean before resetting history.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The working tree must be clean before resetting history." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "重置历史前工作区必须干净。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "重置歷史前工作區必須乾淨。" } },
