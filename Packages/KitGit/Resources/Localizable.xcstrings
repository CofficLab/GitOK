      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The current HEAD changed before the reset could start." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "重置开始前当前 HEAD 已发生变化。" } },
