    },
    "The selected commit is no longer the current HEAD.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The selected commit is no longer the current HEAD." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "选中的提交已不是当前 HEAD。" } },
