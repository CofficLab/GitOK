        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲、运行与忙碌状态反映 GitOK 当前在做什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空閒、運行與忙碌狀態反映 GitOK 當前在做什麼。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
