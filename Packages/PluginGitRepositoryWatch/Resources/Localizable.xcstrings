    "Changes are broadcast per dimension so each view refreshes precisely.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes are broadcast per dimension so each view refreshes precisely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按维度广播变化，各视图精确刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依維度廣播變化，各檢視精確重新整理。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "依維度廣播變化，各檢視精確重新整理。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "依維度廣播變化，各檢視精確重新整理。"
          }
        }
      }
    },
