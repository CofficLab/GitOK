    "Monitors the real .git directory with file system events, not polling.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitors the real .git directory with file system events, not polling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用文件系统事件监听真正的 .git 目录，而非轮询。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用檔案系統事件監聽真正的 .git 目錄，而非輪詢。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用檔案系統事件監聽真正的 .git 目錄，而非輪詢。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "用檔案系統事件監聽真正的 .git 目錄，而非輪詢。"
          }
        }
      }
    },
    "See repository changes the moment they happen — even from outside GitOK.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See repository changes the moment they happen — even from outside GitOK."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库一有变化立即可见——即使来自 GitOK 之外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存庫一有變化立即可見——即使來自 GitOK 之外。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存庫一有變化立即可見——即使來自 GitOK 之外。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存庫一有變化立即可見——即使來自 GitOK 之外。"
          }
        }
      }
    },
    "Terminal stash, checkout, or third-party tools instantly refresh the UI.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal stash, checkout, or third-party tools instantly refresh the UI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端的 stash、checkout 或第三方工具改动会立即刷新界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端的 stash、checkout 或第三方工具變更會立即重新整理介面。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "終端的 stash、checkout 或第三方工具變更會立即重新整理介面。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "終端的 stash、checkout 或第三方工具變更會立即重新整理介面。"
          }
        }
      }
    },
