        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存庫操作快速，記憶體可控，無程序開銷。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存庫操作快速，記憶體可控，無程序開銷。"
