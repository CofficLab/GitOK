    "LibGit2Swift links the mature libgit2 C library directly into the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LibGit2Swift links the mature libgit2 C library directly into the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LibGit2Swift 将成熟的 libgit2 C 库直接链接进应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LibGit2Swift 將成熟的 libgit2 C 函式庫直接連結進應用程式。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "LibGit2Swift 將成熟的 libgit2 C 函式庫直接連結進應用程式。"
