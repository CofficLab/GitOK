    "libgit2 runs natively in the app process, no subprocess spawning.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "libgit2 runs natively in the app process, no subprocess spawning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "libgit2 在应用进程内原生运行，不派生子进程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "libgit2 在應用程式程序內原生執行，不派生子程序。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "libgit2 在應用程式程序內原生執行，不派生子程序。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "libgit2 在應用程式程序內原生執行，不派生子程序。"
          }
        }
