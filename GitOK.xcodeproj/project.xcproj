{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Project-Debug.xcconfig" },
    { "name": "Release", "file": "Project-Release.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "zh-HK",
      "zh-Hans",
      "zh-Hant",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/CofficLab/LumiLogging.git",
      "version": {
        "up-to-next-major-version": "1.0.1",
      },
    }, {
      "kind": "local",
      "path": "Packages/FactoryGitOK",
    }, {
      "kind": "local",
      "path": "Packages/KitGitOKUpdate",
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "GitOKApp",
      "target-membership": [
        "GitOK",
      ],
      "membership-exceptions": [
        {
          "target": "GitOK",
          "exclusions": [
            "GitOK-Info.plist",
          ],
        },
      ],
    },
    { "path": "<PRODUCTS>/GitOK.app", "id": "GK0000000000000000000002", "type": "wrapper.application", "index": false },
    { "path": "<PRODUCTS>/GitOKUITests.xctest", "id": "GK0000000000000000000010", "type": "wrapper.cfbundle", "index": false },
    { "kind": "folder", "path": "GitOKUITests", "target-membership": [ "GitOKUITests" ] },
    { "kind": "group", "name": "Frameworks" },
    { "path": "GitOKApp/Config/Project-Debug.xcconfig", "index": true },
    { "path": "GitOKApp/Config/Project-Release.xcconfig", "index": true },
    { "path": "GitOKApp/GitOK.xcconfig", "index": true },
  ],
  "targets": [
    {
      "name": "GitOK",
      "id": "GK0000000000000000000009",
      "product": "GitOK.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": "GitOK.xcconfig" },
        { "name": "Release", "file": "GitOK.xcconfig" },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "FactoryGitOK",
          "product-name": "FactoryGitOK",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "KitGitOKUpdate",
          "product-name": "KitGitOKUpdate",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
    }, {
      "name": "GitOKUITests",
      "id": "GK0000000000000000000012",
      "product": "GitOKUITests.xctest",
      "product-type": "bundle.ui-testing",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "14.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.coffic.GitOKUITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "macosx",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_VERSION": "5.0",
        "TEST_TARGET_NAME": "GitOK",
      },
    },
  ],
  "products-group": [
  ],
  "last-upgrade": "26.2",
  "last-swift-update": "26.2",
}
