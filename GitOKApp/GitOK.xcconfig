//
// GitOK.xcconfig
// GitOK macOS target（Debug 与 Release 共用）。
// GitOK 作为 Lumi 架构下的平级 App，共享同一套 App-Shared 配置。
//

#include "Config/App-Shared.xcconfig"

// 仅支持 macOS。
SUPPORTED_PLATFORMS = macosx
SUPPORTS_MACCATALYST = NO
MACOSX_DEPLOYMENT_TARGET = 14.0
ENABLE_HARDENED_RUNTIME = YES
COMBINE_HIDPI_IMAGES = YES

// 产品身份。
PRODUCT_BUNDLE_IDENTIFIER = com.yueyi.GitOK
INFOPLIST_KEY_CFBundleDisplayName = GitOK
PRODUCT_NAME = GitOK

// 平台专用 Info.plist 配置。
INFOPLIST_FILE = GitOKApp/GitOK-Info.plist
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.developer-tools

// 图标
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// macOS 沙盒：关闭。
// GitOK 是需要读取任意本地 Git 仓库的开发工具，且依赖系统 git CLI 子进程；
// 沙盒下子进程无法访问用户选定的仓库目录（security-scoped 授权不继承），
// 导致 commit 读取失败。与旧版 GitOK 一致保持非沙盒运行。
ENABLE_APP_SANDBOX = NO

// 权限
CODE_SIGN_ENTITLEMENTS = GitOKApp/App.entitlements

// 版本号
MARKETING_VERSION = 4.0.6
CURRENT_PROJECT_VERSION = 406
